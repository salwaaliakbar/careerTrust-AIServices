# Shared secret the frontend/backend must send as the X-API-Key header on every
# request to this service. Generate a long random value for production.
API_KEY=change-me

# Comma-separated list of origins allowed to call this API via CORS
# (your Vercel frontend URL and Render Node-backend URL, if it calls this directly).
ALLOWED_ORIGINS=http://localhost:3000

# When true, /face-embedding skips real face detection and always returns a match.
# Local development only — must be false (or unset) in production.
DEV_BYPASS_FACE=false
