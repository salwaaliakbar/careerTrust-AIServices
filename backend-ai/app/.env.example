# Shared secret the frontend/backend must send as the X-API-Key header on every
# request to this service. Generate a long random value for production.
API_KEY=change-me

# Comma-separated list of origins allowed to call this API via CORS
# (your Vercel frontend URL and Render Node-backend URL, if it calls this directly).
ALLOWED_ORIGINS=http://localhost:3000

# When true, /face-embedding skips real face detection and always returns a match.
# Local development only — must be false (or unset) in production.
DEV_BYPASS_FACE=false

# Hugging Face Hub repo holding the fine-tuned sentiment DistilBERT checkpoint
# (app/model_output_v3/best.pt + tokenizer files) — too large to commit to git.
# Upload once with scripts/upload_model_to_hf.py, then set this to match.
# The app downloads it automatically from here on the first /sentiment request
# if app/model_output_v3/best.pt isn't already present on disk.
HF_MODEL_REPO=your-username/careertrust-sentiment-distilbert
